{
  "manifest_version": 3,
  "name": "OpenJarvis Midas Paneli",
  "version": "0.1.0",
  "description": "Midas sayfasında salt-okur BIST/döviz/altın fiyat ve alarm paneli. Emir vermez.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "OpenJarvis Borsa Paneli"
  }
}
